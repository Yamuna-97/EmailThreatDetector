# =============================================================================
# CyberTrace Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# On Vercel: set these in Project Settings -> Environment Variables.
# IMPORTANT: Only VITE_ prefixed variables are safe to expose in the browser.
# NEVER put server-side secrets (Gemini, IPQS, Google Client Secret) here.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API URL (your Render backend — no trailing slash on /api)
# After Render deployment, replace with your actual Render URL:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# ---------------------------------------------------------------------------
# Supabase (public/anon key only — safe to expose in browser)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here