# =============================================================================
# CyberTrace Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# On Render: set these in the "Environment" tab of your service.
# =============================================================================

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# CORS - set this to your Vercel frontend URL (no trailing slash)
# In production: CORS_ORIGINS=https://your-app.vercel.app
# For multiple origins, separate by comma:
#   CORS_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Supabase Configuration (managed PostgreSQL)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Google OAuth 2.0 & Gmail API
# GOOGLE_REDIRECT_URI in production must be:
#   https://your-render-backend.onrender.com/api/gmail/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here
GOOGLE_REDIRECT_URI=https://your-render-backend.onrender.com/api/gmail/callback

# ---------------------------------------------------------------------------
# Gemini AI Engine (NEVER expose in frontend)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---------------------------------------------------------------------------
# IPQualityScore Threat Intelligence (NEVER expose in frontend)
# ---------------------------------------------------------------------------
IPQS_API_KEY=your-ipqs-api-key

# ---------------------------------------------------------------------------
# IP Geolocation Provider
# ---------------------------------------------------------------------------
IP_GEOLOCATION_API_KEY=
IP_GEOLOCATION_BASE_URL=https://ipapi.co

# ---------------------------------------------------------------------------
# SMTP Security Alerting
# Use a Gmail App Password (not your regular Gmail password).
# Generate at: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alert-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password-16-chars
ALERT_RECIPIENT_EMAIL=your-alert-recipient@gmail.com

# ---------------------------------------------------------------------------
# Admin / Investigator Access Control
# ADMIN_EMAIL: primary admin fallback user email
# ADMIN_INVESTIGATOR_EMAILS: comma-separated emails that receive investigator role
# ---------------------------------------------------------------------------
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_INVESTIGATOR_EMAILS=admin@gmail.com,investigator@gmail.com

# ---------------------------------------------------------------------------
# Gmail Automatic Monitoring (optional - Pub/Sub push mode)
# Leave GOOGLE_PUBSUB_PROJECT_ID empty to use polling mode (simpler, no GCP needed)
# ---------------------------------------------------------------------------
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC_ID=gmail-watch-topic
GOOGLE_PUBSUB_PUSH_TOKEN=
AUTO_MONITOR_POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Gunicorn concurrency (optional - Render default: 2 workers)
# ---------------------------------------------------------------------------
WEB_CONCURRENCY=2